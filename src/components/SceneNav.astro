---
/**
 * SceneNav — sticky pill-style navigation under the header.
 *
 * Row 1 (Browse:) renders one pill per bucket, plus a Birthdays pill and a
 * Venues pill. After the architectural split (Jun 2026), each bucket pill
 * links to that bucket's dedicated top-level page (/florida, /japan, ...).
 * The inline count keeps showing how many entries are in each bucket.
 *
 * Row 2 (Field Trips:) — places we're actually going. Wacken 2026 and
 * Metal London. No counts.
 *
 * Row 3 (Scene Briefs:) — editorial briefing pages that aren't field trips
 * and don't map to a ClickUp bucket. Japan Scene, Japan Global. No counts.
 *
 * Optional `activeBucketId` lets a page highlight its own pill. Pass either
 * a bucket id (e.g. 'florida-metal-scene'), 'birthdays', 'venues', or a
 * field-trip / brief id ('wacken', 'london', 'japan-scene', 'japan-global').
 */
import type { BucketConfig, ConcertEntry, BucketsConfigFile, ConcertsDataFile, BirthdaysDataFile } from '../lib/types';
import { hasFreshAlbums } from '../lib/albums';
import bucketsConfig from '../../buckets.config.json';
import concertsData from '../../concerts.json';
import birthdaysData from '../../birthdays.json';
import { categorize, groupByBucket } from '../lib/categorize';
import { collectKnownVenues, reparseEntry } from '../lib/parse-name';

interface Props {
  buckets?: BucketConfig[];
  grouped?: Map<string, ConcertEntry[]>;
  birthdaysCount?: number;
  /**
   * If set, the matching pill gets the `is-active` class for visual emphasis.
   * Use either a bucket id (e.g. 'florida-metal-scene'), 'birthdays', 'venues',
   * or a field-trip / brief id ('wacken', 'london', 'japan-scene', 'japan-global').
   */
  activeBucketId?: string;
}

const { activeBucketId } = Astro.props;
const buckets = (bucketsConfig as BucketsConfigFile).buckets;
const _data = concertsData as ConcertsDataFile;
const _known = collectKnownVenues(buckets);
const _today = new Date().toISOString().slice(0, 10);
const _upcoming: ConcertEntry[] = (_data.entries ?? [])
  .filter((e) => { const c = e.endDate ?? e.date; return c >= _today; })
  .map((e) => reparseEntry(e, _known))
  .map((e) => ({ ...e, buckets: categorize(e, buckets) }));
const grouped = groupByBucket(_upcoming, buckets);
const birthdaysCount = ((birthdaysData as BirthdaysDataFile).entries ?? []).length;

/**
 * Map a bucket id to its top-level slug. Kept in one place so the
 * architectural URL scheme is easy to audit.
 */
const BUCKET_HREFS: Record<string, string> = {
  'florida-metal-scene': '/florida',
  'japanese-metal': '/japan',
  'key-festivals': '/festivals',
  'interesting-elsewhere': '/elsewhere',
  'album-releases': '/releases',
};

/**
 * Field Trips — where we're actually going. Chronological order.
 */
const FIELD_TRIPS: { id: string; name: string; href: string }[] = [
  { id: 'turnstile', name: 'Turnstile & Hatebreed', href: '/turnstile' },
  { id: 'buddy-guy', name: 'Buddy Guy at 90', href: '/buddy-guy' },
  { id: 'wacken', name: 'Wacken 2026', href: '/wacken' },
  { id: 'london', name: 'Metal London', href: '/london' },
  { id: 'namm', name: 'NAMM 2027', href: '/namm' },
];

/**
 * Scene Briefs — editorial dashboards that live alongside the bucket pages.
 * Wacken was promoted to a Field Trip; only the two Japan briefs remain.
 */
const SCENE_BRIEFS: { id: string; name: string; href: string }[] = [
  { id: 'miami', name: 'Miami Metal', href: '/miami' },
  { id: 'japan-scene', name: 'Japan Scene', href: '/japan-scene' },
  { id: 'japan-global', name: 'Japan Global', href: '/japan-global' },
];
---

<nav class="scene-nav" aria-label="Browse the scene">
  <div class="container scene-nav__inner">
    <button type="button" class="scene-nav__toggle" aria-expanded="false" aria-controls="scene-nav-panel">Browse the scene</button>
    <div class="scene-nav__panel" id="scene-nav-panel">
    <div class="scene-nav__row">
      <span class="scene-nav__label">Browse:</span>
      <ul class="scene-nav__list">
        {buckets.map((bucket) => {
          const count = grouped.get(bucket.id)?.length ?? 0;
          const href = BUCKET_HREFS[bucket.id] ?? `#bucket-${bucket.id}`;
          const isActive = activeBucketId === bucket.id;
          return (
            <>
            <li class="scene-nav__item">
              <a class={`scene-nav__link${isActive ? ' is-active' : ''}`} href={href} aria-current={isActive ? 'page' : undefined}>
                <span class="scene-nav__name">{bucket.name}</span>
                {bucket.kanji ? <span class="scene-nav__kanji" lang="ja">{bucket.kanji}</span> : null}
                <span class="scene-nav__count" aria-label={`${count} entries`}>{count}</span>
              </a>
            </li>
            {bucket.id === 'florida-metal-scene' && (<>
              <li class="scene-nav__item"><a class={"scene-nav__link" + (activeBucketId === 'interviews' ? ' is-active' : '')} href="/interviews" aria-current={activeBucketId === 'interviews' ? 'page' : undefined}><span class="scene-nav__name">Interviews</span></a></li>
              <li class="scene-nav__item"><a class={"scene-nav__link" + (activeBucketId === 'map' ? ' is-active' : '')} href="/map" aria-current={activeBucketId === 'map' ? 'page' : undefined}><span class="scene-nav__name">Map</span></a></li>
            </>)}
            </>
          );
        })}
        {birthdaysCount && birthdaysCount > 0 ? (
          <li class="scene-nav__item">
            <a class={`scene-nav__link${activeBucketId === 'birthdays' ? ' is-active' : ''}`} href="/birthdays" aria-current={activeBucketId === 'birthdays' ? 'page' : undefined}>
              <span class="scene-nav__name">Birthdays</span>
              <span class="scene-nav__count">{birthdaysCount}</span>
            </a>
          </li>
        ) : null}
        <li class="scene-nav__item">
          <a class={`scene-nav__link${activeBucketId === 'venues' ? ' is-active' : ''}`} href="/venues" aria-current={activeBucketId === 'venues' ? 'page' : undefined}>
            <span class="scene-nav__name">Venues</span>
          </a>
        </li>
        <li class="scene-nav__item">
          <a class={`scene-nav__link${activeBucketId === 'watching' ? ' is-active' : ''}`} href="/watching" aria-current={activeBucketId === 'watching' ? 'page' : undefined}>
            <span class="scene-nav__name">Bands We Watch</span>
          </a>
        </li>
        <li class="scene-nav__item">
          <a class={"scene-nav__link" + (activeBucketId === 'wire' ? ' is-active' : '')} href="/wire" aria-current={activeBucketId === 'wire' ? 'page' : undefined}>
            <span class="scene-nav__name">Label Wire</span>
          </a>
        </li>
        <li class="scene-nav__item">
          <a class={`scene-nav__link${activeBucketId === 'photos' ? ' is-active' : ''}`} href="/photos" aria-current={activeBucketId === 'photos' ? 'page' : undefined}>
            <span class="scene-nav__name">Photos</span>{hasFreshAlbums() ? <span class="scene-nav__new" aria-label="New albums">NEW</span> : null}
          </a>
        </li>
      </ul>
    </div>

    <div class="scene-nav__row scene-nav__row--briefs">
      <span class="scene-nav__label">Field Trips:</span>
      <ul class="scene-nav__list">
        {FIELD_TRIPS.map((trip) => {
          const isActive = activeBucketId === trip.id;
          return (
            <li class="scene-nav__item">
              <a class={`scene-nav__link${isActive ? ' is-active' : ''}`} href={trip.href} aria-current={isActive ? 'page' : undefined}>
                <span class="scene-nav__name">{trip.name}</span>
              </a>
            </li>
          );
        })}
      </ul>
    </div>

    <div class="scene-nav__row scene-nav__row--briefs">
      <span class="scene-nav__label">Scene Briefs:</span>
      <ul class="scene-nav__list">
        {SCENE_BRIEFS.map((brief) => {
          const isActive = activeBucketId === brief.id;
          return (
            <li class="scene-nav__item">
              <a class={`scene-nav__link${isActive ? ' is-active' : ''}`} href={brief.href} aria-current={isActive ? 'page' : undefined}>
                <span class="scene-nav__name">{brief.name}</span>
              </a>
            </li>
          );
        })}
      </ul>
    </div>
    </div>
  </div>
</nav>

<style is:global>
  .scene-nav__toggle { display: none; }
  .scene-nav__panel { display: contents; }

  /* Compact the scene nav on phones. High specificity + !important so it wins over the base .scene-nav rules regardless of stylesheet order. */
  @media (max-width: 640px) {
    nav.scene-nav .scene-nav__inner { gap: 0.4rem !important; padding-top: 0.5rem !important; padding-bottom: 0.5rem !important; }
    nav.scene-nav .scene-nav__row { margin: 0 !important; }
    nav.scene-nav .scene-nav__label { font-size: 0.55rem !important; letter-spacing: 0.1em !important; margin: 0 !important; }
    nav.scene-nav .scene-nav__list { gap: 0.3rem !important; }
    nav.scene-nav .scene-nav__link { padding: 0.24rem 0.55rem !important; font-size: 0.7rem !important; gap: 0.25rem !important; }
    nav.scene-nav .scene-nav__count { font-size: 0.58rem !important; min-width: 1.2em !important; padding: 0 0.3rem !important; line-height: 1.5 !important; }
    nav.scene-nav .scene-nav__kanji { font-size: 0.6rem !important; }
    nav.scene-nav .scene-nav__list { flex-wrap: wrap !important; }
    nav.scene-nav .scene-nav__kanji { display: none !important; }
    nav.scene-nav .scene-nav__count { display: none !important; }
    nav.scene-nav .scene-nav__row { margin-bottom: 0.35rem !important; }
    nav.scene-nav .scene-nav__toggle { display: block; width: 100%; text-align: left; background: transparent; border: 0; color: #e11d2a; font-weight: 700; font-size: 0.68rem; letter-spacing: 0.12em; text-transform: uppercase; padding: 0.35rem 0; cursor: pointer; }
    nav.scene-nav .scene-nav__toggle::after { content: " \25BE"; }
    nav.scene-nav.is-open .scene-nav__toggle::after { content: " \25B4"; }
    nav.scene-nav .scene-nav__panel { display: none; }
    nav.scene-nav.is-open .scene-nav__panel { display: block; padding-bottom: 0.35rem; }
  }
</style>

<script is:inline>
  (function () {
    var nav = document.querySelector('.scene-nav');
    var btn = nav && nav.querySelector('.scene-nav__toggle');
    if (btn) {
      btn.addEventListener('click', function () {
        var open = nav.classList.toggle('is-open');
        btn.setAttribute('aria-expanded', open ? 'true' : 'false');
      });
    }
  })();
</script>

<style>
  .scene-nav__new { display: inline-block; margin-left: 6px; padding: 0 5px; border-radius: 999px; background: #e11d2a; color: #fff; font-size: 9px; font-weight: 800; letter-spacing: 0.05em; line-height: 15px; vertical-align: middle; text-transform: uppercase; }
</style>
