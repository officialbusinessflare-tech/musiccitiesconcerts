  .cj-hero__title em { color: var(--color-accent-hover); font-style: normal; }
  .cj-hero__lede { font-size: 1.02rem; color: var(--color-text-muted); max-width: 46ch; margin: 0; }
  .cj-hero__poster { display: block; border-radius: var(--radius-lg); overflow: hidden; border: 1px solid var(--color-border); box-shadow: 0 10px 30px rgba(0,0,0,0.5); }
  .cj-hero__poster img { display: block; width: 100%; height: auto; }

  .cj-main { padding: 2.4rem 0 1rem; }
  .cj-article { max-width: 760px; }
  .cj-article p { font-size: 1.06rem; line-height: 1.72; color: var(--color-text); margin: 0 0 1.25rem; }
  .cj-lead { font-size: 1.2rem !important; line-height: 1.6 !important; color: var(--color-text) !important; font-weight: 500; }
  .cj-signoff { text-align: center; color: var(--color-accent-hover); font-size: 1.25rem !important; letter-spacing: 0.08em; margin-top: 2rem !important; padding-top: 1.5rem; border-top: 1px solid var(--color-border); }

  .cj-figure { margin: 2rem 0; }
  .cj-figure a { display: block; border-radius: var(--radius-lg); overflow: hidden; border: 1px solid var(--color-border); }
  .cj-figure img { display: block; width: 100%; height: auto; }
  .cj-figure figcaption { margin-top: 0.6rem; font-size: 0.85rem; color: var(--color-text-dim); text-align: center; }

  .cj-interviews { margin-top: 2.5rem; padding: 2.6rem 0 3.2rem; background: var(--color-bg-section); border-top: 1px solid var(--color-border); }
  .cj-interviews__head { text-align: center; max-width: 640px; margin: 0 auto 1.8rem; }
  .cj-interviews__title { font-size: clamp(1.8rem, 4vw, 2.6rem); margin: 0 0 0.3rem; font-weight: 800; }
  .cj-interviews__title em { color: var(--color-accent-hover); font-style: normal; }
  .cj-interviews__sub { font-size: 1.25rem; color: var(--color-text); margin: 0 0 0.6rem; font-weight: 700; }
  .cj-interviews__dek { color: var(--color-text-muted); margin: 0; }

  .cj-promo { display: block; max-width: 760px; margin: 0 auto 2rem; border-radius: var(--radius-lg); overflow: hidden; border: 1px solid var(--color-border); box-shadow: 0 10px 30px rgba(0,0,0,0.5); }
  .cj-promo img { display: block; width: 100%; height: auto; }

  .cj-grid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 1.1rem; }
  .cj-card { background: var(--color-bg-elev); border: 1px solid var(--color-border); border-radius: var(--radius-lg); overflow: hidden; transition: border-color 0.15s ease, transform 0.15s ease; }
  .cj-card:hover { border-color: var(--color-accent); transform: translateY(-2px); }
  .cj-card img { display: block; width: 100%; height: auto; }
  .cj-card__cap { padding: 0.7rem 0.85rem 0.85rem; display: flex; flex-direction: column; gap: 0.15rem; }
  .cj-card__band { font-weight: 700; font-size: 1rem; }
  .cj-card__meta { font-size: 0.8rem; color: var(--color-text-dim); }

  .cj-interviews__foot { text-align: center; margin: 2rem 0 0; }
  .cj-interviews__foot a { color: var(--color-accent-hover); font-weight: 700; text-decoration: none; }
  .cj-interviews__foot a:hover { text-decoration: underline; }

  @media (max-width: 720px) {
    .cj-hero__inner { grid-template-columns: 1fr; }
    .cj-hero__poster { max-width: 360px; }
  }
</style>
