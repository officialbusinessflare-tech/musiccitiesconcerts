---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import SceneNav from '../components/SceneNav.astro';
import Footer from '../components/Footer.astro';
import BucketSection from '../components/BucketSection.astro';
import BirthdaySection from '../components/BirthdaySection.astro';
import type { BucketsConfigFile, ConcertsDataFile, ConcertEntry, BirthdaysDataFile } from '../lib/types';
import { categorize, groupByBucket } from '../lib/categorize';
import { collectKnownVenues, reparseEntry } from '../lib/parse-name';

// Astro can import JSON directly at build time. concerts.json is regenerated
// nightly by the scheduled function committing back to the repo.
import bucketsConfig from '../../buckets.config.json';
import concertsData from '../../concerts.json';
import birthdaysData from '../../birthdays.json';

const buckets = (bucketsConfig as BucketsConfigFile).buckets;
const data = concertsData as ConcertsDataFile;
const knownVenues = collectKnownVenues(buckets);

const birthdays = (birthdaysData as BirthdaysDataFile).entries ?? [];

// Defensive: filter out anything in the past, just in case the data file
// outpaces the nightly rebuild.
const today = new Date().toISOString().slice(0, 10);
const upcoming: ConcertEntry[] = (data.entries ?? [])
  .filter((e) => {
    const compareDate = e.endDate ?? e.date;
    return compareDate >= today;
  })
  // Re-parse the name at build time. The nightly fetch may have run with an
  // older parser; this lets fixes to parse-name.ts take effect immediately,
  // including venue-collision rescue for titles like "Nemophila with Conduit".
  .map((e) => reparseEntry(e, knownVenues))
  // Re-run categorization at build time so changes to the bucket config or
  // matching logic take effect immediately too.
  .map((e) => ({ ...e, buckets: categorize(e, buckets) }));

const grouped = groupByBucket(upcoming, buckets);

const lastUpdated = data.generatedAt
  ? new Date(data.generatedAt).toLocaleDateString('en-US', {
      year: 'numeric',
      month: 'short',
      day: 'numeric',
    })
  : null;
---

<BaseLayout
  title="The Music Cities — Concerts Dashboard"
  description="Curated metal concerts, festivals, and album releases across Florida, Japan, and the wider scene. Updated nightly."
>
  <Header />
  <SceneNav buckets={buckets} grouped={grouped} birthdaysCount={birthdays.length} />

  <section class="hero-strip">
    <div class="container">
      <h1 class="hero-strip__lede">
        Concerts. Releases. <em>The scene.</em>
      </h1>
      <p class="hero-strip__body">
        Not an aggregator. This is the calendar Kevin actually pays attention to —
        Florida's metal venues, the Japanese watch list, marquee festivals, new
        releases, livestreams, and the records on heavy rotation.
        {lastUpdated ? <span>Last updated {lastUpdated}.</span> : null}
      </p>
    </div>
  </section>

  <a class="feat-review" href="/reviews/spiders">
    <div class="container feat-review__inner">
      <img class="feat-review__art" src="/assets/reviews/spiders-crystal-eyes.jpg" alt="Spiders — Crystal Eyes album cover" width="1200" height="1200" loading="eager" />
      <div class="feat-review__text">
        <span class="feat-review__eyebrow">New review</span>
        <h2 class="feat-review__title">Spiders — <em>Crystal Eyes</em></h2>
        <p class="feat-review__dek">Göteborg's other export, and what a rehearsal room has to do with it. Our review of the fifth album, built on our interview with Ann-Sofie and John Hoyles.</p>
        <span class="feat-review__cta">Read the review →</span>
      </div>
    </div>
  </a>

  <main>
    {buckets.map((bucket) => (
      <BucketSection bucket={bucket} entries={grouped.get(bucket.id) ?? []} />
    ))}
  </main>

  <BirthdaySection entries={birthdays} />

  <Footer />

  <style>
    .feat-review { display: block; text-decoration: none; color: inherit; border-bottom: 1px solid #262626; background: linear-gradient(180deg, #151515, #0e0e0e); transition: background 0.15s ease; }
    .feat-review:hover { background: linear-gradient(180deg, #1b1b1b, #101010); }
    .feat-review__inner { display: flex; gap: 1.25rem; align-items: center; padding: 1.4rem 0; flex-wrap: wrap; }
    .feat-review__art { width: 118px; height: 118px; border-radius: 10px; border: 1px solid rgba(255,255,255,0.14); object-fit: cover; flex: 0 0 auto; display: block; }
    .feat-review__text { flex: 1 1 320px; min-width: 260px; }
    .feat-review__eyebrow { display: inline-block; color: #e11d2a; font-size: 0.72rem; letter-spacing: 0.14em; text-transform: uppercase; margin-bottom: 0.35rem; }
    .feat-review__title { margin: 0 0 0.35rem; font-size: clamp(1.4rem, 3.5vw, 2rem); line-height: 1.1; }
    .feat-review__title em { color: #e11d2a; font-style: normal; }
    .feat-review__dek { margin: 0 0 0.5rem; color: #b7b2a9; line-height: 1.5; max-width: 56ch; }
    .feat-review__cta { color: #fff; font-weight: 600; font-size: 0.95rem; }
    .feat-review:hover .feat-review__cta { color: #e11d2a; }
    @media (max-width: 600px) { .feat-review__art { width: 88px; height: 88px; } }
  </style>
</BaseLayout>
