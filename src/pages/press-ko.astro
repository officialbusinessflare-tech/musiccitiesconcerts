---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import SceneNav from '../components/SceneNav.astro';
import Footer from '../components/Footer.astro';

/**
 * /press-ko — The Music Cities 보도자료(한국어).
 * 사진과 PDF는 복구된 배포본(PERMA)에서 임시로 제공됩니다.
 */
const PERMA = 'https://6aafd11c987f7a70480b2a64--musiccitiesconcerts.netlify.app';

const photos = [
  { src: PERMA + '/assets/press/nemophila-orlando.jpg', alt: '맞춤 제작 Music Cities 셔츠를 든 NEMOPHILA, 올랜도', cap: 'NEMOPHILA 인터뷰, 올랜도' },
  { src: PERMA + '/assets/press/broken-by-the-scream-london.jpg', alt: '런던에서 Broken by the Scream 인터뷰', cap: 'Broken by the Scream 인터뷰, 런던' },
  { src: PERMA + '/assets/press/nicko-mcbrain.jpg', alt: 'Iron Maiden의 Nicko McBrain과의 점심', cap: 'Nicko McBrain(Iron Maiden)과의 점심' },
];
---

<BaseLayout
  title="보도자료 | The Music Cities"
  description="The Music Cities 보도자료. 경제 개발과 장소 만들기의 관점으로 메탈 신을 다루는 가시성 플랫폼입니다."
>
  <Header />
  <SceneNav />

  <section class="dash-hero">
    <div class="container">
      <p class="dash-hero__eyebrow">보도자료</p>
      <h1 class="dash-hero__title">The Music <em>Cities</em></h1>
      <p class="dash-hero__lede">
        마이애미를 기반으로 경제 개발과 장소 만들기의 관점에서 메탈 신을 다루는 가시성 플랫폼입니다. 이미 존재하지만 보이지 않는 밴드, 신, 그리고 경제를 찾아내 올바르게 이름 붙이고, 원래 반응했을 관객 앞에 내놓습니다.
      </p>
      <p class="press-langs"><a href="/press">English</a> · <a href="/press-ja">日本語</a> · <a href="/press-es">Español</a> · <a href="/press-de">Deutsch</a> · <strong>한국어</strong></p>
    </div>
  </section>

  <main class="dash-main">
    <div class="container">

      <div class="press-figs">
        {photos.map((p) => (
          <figure>
            <img src={p.src} alt={p.alt} loading="lazy" decoding="async" />
            <figcaption>{p.cap}</figcaption>
          </figure>
        ))}
      </div>

      <section class="dash-section">
        <h2 class="dash-section__title">운영자 소개</h2>
        <p>
          이것은 외부에서 바라본 취재가 아닙니다. Kevin Crowder는 40년 동안 오리지널 밴드와 커버 밴드에서 기타를 연주해 왔으며, 현재도 마이애미 메탈 밴드
          <a href="https://www.youtube.com/watch?v=Ltyj3hbklU8" target="_blank" rel="noopener noreferrer">McFisty</a>
          에서 무대에 섭니다. 그전에는 War Department, Cone of Silence, Phantasie, The Mix에 있었습니다. 이 두 측면이 모두 중요한 이유는, 오리지널 신을 키우는 도시와 커버 밴드만 부르는 도시의 차이가 이 채널이 끊임없이 주장하는 논점이며, 그것이 탁상공론이 아니기 때문입니다. 그는 인터뷰하는 밴드와 같은 로딩 도어로 들어가고, 모든 공연에서 머치를 사며, 나쁜 공연장이 밴드에게 어떤 대가를 치르게 하는지 압니다.
        </p>
        <p>
          다른 한 축은 본업입니다. 그는 미 육군 참전용사이며, 플로리다 경제 개발 분야에서 30년, 그중 15년은 사우스비치 변모기에 마이애미비치시의 경제 개발 국장을 지냈고, 참전용사가 운영하는 경제 개발 회사
          <a href="https://businessflare.net" target="_blank" rel="noopener noreferrer">BusinessFlare</a>
          의 창업자입니다. 그렇기에 이 채널은 메탈 페스티벌에 대한 실제 경제 효과 분석을 수행하고, 주최 측과 시 양쪽 모두가 이를 믿게 만들 수 있습니다.
        </p>
      </section>

      <section class="dash-section">
        <h2 class="dash-section__title">도달 범위</h2>
        <dl class="press-defs">
          <div><dt>구독자</dt><dd>YouTube 152,000명, 2025년 8월 개설.</dd></div>
          <div><dt>총 조회수</dt><dd>285개 영상에서 337만 회.</dd></div>
          <div><dt>위상</dt><dd>YouTube에서 가장 구독자가 많은 경제 개발 채널(큰 격차로 1위).</dd></div>
          <div><dt>최근 취재 지역</dt><dd>마이애미, 올랜도, 탬파, 휴스턴, 오스틴, 런던, 바켄.</dd></div>
        </dl>
      </section>

      <section class="dash-section">
        <h2 class="dash-section__title">사이트와 앱</h2>
        <p>
          <a href="https://themusiccities.com/" target="_blank" rel="noopener noreferrer">themusiccities.com</a>
          은 채널의 자매 사이트로 매일 밤 갱신되는 공연·신 대시보드이며, 외부 수집물이 아니라 우리 자체 편집 캘린더로 만들어집니다. 플로리다 메탈 캘린더, 일본 및 아시아 메탈 관찰 목록, 주요 페스티벌, 공연장, 앨범 발매, 아티스트 생일, 레이블 와이어, 신 지도, 필드 트립 브리핑을 다룹니다.
        </p>
        <dl class="press-defs">
          <div><dt><a href="/florida">Florida Metal Scene</a></dt><dd>공연장별로 이어지는 플로리다 상시 캘린더.</dd></div>
          <div><dt><a href="/japan">Japanese and Asian Metal</a></dt><dd>관찰 목록, 투어 일정, 발매 정보.</dd></div>
          <div><dt><a href="/festivals">Key Festivals</a></dt><dd>우리가 추적하고 찾아가는 주요 페스티벌.</dd></div>
          <div><dt><a href="/app">앱</a></dt><dd>안드로이드 다운로드는 현재 가능, 아이폰·아이패드는 홈 화면 설치로 이용, 앱 스토어는 추후 예정.</dd></div>
        </dl>
      </section>

      <section class="dash-section">
        <h2 class="dash-section__title">인터뷰 프로그램</h2>
        <p>
          정식 대담과 3 Questions 시리즈. 전체 모음은
          <a href="https://www.youtube.com/playlist?list=PLb5XblrwD0ZF0asSK72gGUAQm72Mqy8ZT" target="_blank" rel="noopener noreferrer">한 개의 재생목록</a>
          에 있으며, 전체 명단은 <a href="/interviews">인터뷰 페이지</a>에 있습니다.
        </p>
        <dl class="press-defs">
          <div>
            <dt><a href="https://www.youtube.com/watch?v=pJmFKOQ38e0" target="_blank" rel="noopener noreferrer">NEMOPHILA</a></dt>
            <dd>조회수 182,000회, 평균 시청 지속률 44.5퍼센트. 일본 메탈, 올랜도에서 촬영.
              <span class="press-quote">"40년 넘게 메탈 콘서트를 다녀왔습니다… 올랜도 공연에서 만나 뵈어 정말 좋았어요." — SuperSport2024</span>
              <span class="press-quote">"Hazuki가 언급한 '와(和)'와 SAMURAI에 대한 언급이 그들의 음악의 일부라고 늘 느꼈습니다… 일본 메탈은 분명 전 세계로 퍼졌고, 특히 여성 밴드들이 그렇습니다. 아주 멋진 인터뷰였습니다." — derekwooding5354</span>
            </dd>
          </div>
          <div>
            <dt><a href="https://www.youtube.com/watch?v=QGW5tLmv_Ds" target="_blank" rel="noopener noreferrer">BRIDEAR</a></dt>
            <dd>조회수 109,000회. 성공적인 크라우드펀딩 캠페인을 지원하기 위해 촬영.
              <span class="press-quote">"바로 후원했습니다. 이들이 계속 음악을 만들 수 있기를 진심으로 바랍니다." — jamessharp2725</span>
            </dd>
          </div>
          <div>
            <dt><a href="https://www.youtube.com/watch?v=Sky1HWb5cP8" target="_blank" rel="noopener noreferrer">Broken by the Scream</a></dt>
            <dd>조회수 68,000회. 런던에서 촬영.
              <span class="press-quote">"BBTS를 5년 넘게 팔로우해 왔습니다… 바켄에 이르기까지 그들이 쌓아온 커리어에 정말 감탄했습니다." — NemusVetus</span>
            </dd>
          </div>
          <div>
            <dt><a href="https://www.youtube.com/watch?v=r8klGaDF1gE" target="_blank" rel="noopener noreferrer">Nini</a></dt>
            <dd>대만 포크 메탈, 무소속. 6일 만에 조회수 11,000회.
              <span class="press-quote">"당신의 채널에 나오기 전까지 이 아티스트를 몰랐습니다." — Mark-J-metal</span>
            </dd>
          </div>
          <div><dt>사운드체크와 무대 뒤</dt><dd>개장 전에 우리를 들여보내 준 밴드들도 있습니다. NEMOPHILA는 올랜도에서 사운드체크 촬영에 초대했고, Broken by the Scream도 런던에서 같았습니다.</dd></div>
          <div><dt>공연 사진</dt><dd>공연에서 촬영해 Pinterest에 공개합니다. 목적은 맥락이지 사진 판매 서비스가 아닙니다. 사진을 판매하지 않습니다.</dd></div>
        </dl>
      </section>

      <section class="dash-section">
        <h2 class="dash-section__title">맨바닥에서 시작하는 밴드</h2>
        <p>3 Questions 시리즈. 데려올 기존 관객이 없는 지역 밴드들.</p>
        <dl class="press-defs">
          <div><dt><a href="https://www.youtube.com/watch?v=MJnQVxduebk" target="_blank" rel="noopener noreferrer">We All Rise</a></dt><dd>마이애미. 조회수 244,000회.</dd></div>
          <div><dt><a href="https://www.youtube.com/watch?v=ERucE5hitSY" target="_blank" rel="noopener noreferrer">Nocturnal Dawn</a></dt><dd>올랜도, Wacken Metal Battle Florida. 조회수 126,000회.</dd></div>
          <div><dt><a href="https://www.youtube.com/watch?v=WMFPAcPMkpg" target="_blank" rel="noopener noreferrer">SevenSins</a></dt><dd>마이애미. 조회수 67,000회.</dd></div>
          <div><dt><a href="https://www.youtube.com/watch?v=LUKyg4Dpddc" target="_blank" rel="noopener noreferrer">Nemesis</a></dt><dd>휴스턴, Wacken Metal Battle Texas. 조회수 18,000회.</dd></div>
        </dl>
      </section>

      <section class="dash-section">
        <h2 class="dash-section__title">Band of the Year</h2>
        <p>매년 해당 밴드에게 직접 전달하고 에피소드로 다룹니다.</p>
        <dl class="press-defs">
          <div><dt><a href="https://www.youtube.com/watch?v=9240E0hxKCY" target="_blank" rel="noopener noreferrer">LOVEBITES 2025</a></dt><dd>런던에서 전달. 에피소드 조회수 67,000회.</dd></div>
          <div><dt><a href="https://www.youtube.com/watch?v=z72FZugv3R8" target="_blank" rel="noopener noreferrer">HANABIE. 2026</a></dt><dd>오스틴에서 전달. 에피소드 조회수 105,000회.</dd></div>
        </dl>
      </section>

      <section class="dash-section">
        <h2 class="dash-section__title">지도로 그린 신</h2>
        <p>
          오직 공개 자료만으로, 모든 노드가 인용 가능한 기록에 기반한 네트워크이자 계보로서의 신 지도. 이런 것을 가진 음악 매체는 없습니다. 밴드를 인터뷰할 때 우리는 이미 그들이 나온 계보를 알고 있습니다.
        </p>
        <dl class="press-defs">
          <div><dt><a href="https://japan.themusiccities.com/" target="_blank" rel="noopener noreferrer">일본 헤비메탈 가계도</a></dt><dd>1967년부터 2026년까지, 319개 노드. 오늘날 여성 중심 신을 멤버 단위로 지도화.</dd></div>
          <div><dt><a href="https://tampa.themusiccities.com/" target="_blank" rel="noopener noreferrer">탬파 데스메탈 가계도</a></dt><dd>1979년부터 2026년까지, 371개 노드와 1,130개 연결. 모든 Morrisound Recording 크레딧을 앨범 단위로 검증.</dd></div>
          <div><dt><a href="https://westdixiestudios.themusiccities.com/" target="_blank" rel="noopener noreferrer">West Dixie Music Corridor</a></dt><dd>5개 관할에 걸친 236개 노드. 1958년 이후 Criteria Studios를 추적하고, 링 내부에 라이브 스테이지가 없음을 기록. 무대 없는 스튜디오들.</dd></div>
        </dl>
      </section>

      <section class="dash-section">
        <h2 class="dash-section__title">사례 연구 에피소드</h2>
        <p>채널의 핵심. 경제 개발로 읽는 메탈의 역사.</p>
        <dl class="press-defs">
          <div><dt><a href="https://www.youtube.com/watch?v=kgbDiHq6piI" target="_blank" rel="noopener noreferrer">Scorpions, 글로벌 제국의 건설</a></dt><dd>조회수 153,000회.</dd></div>
          <div><dt><a href="https://www.youtube.com/shorts/STsGDIsq0W8" target="_blank" rel="noopener noreferrer">Brewtality Metal Fest 경제 효과</a></dt><dd>조회수 92,000회. 메탈 페스티벌의 경제 효과 분석.</dd></div>
          <div><dt><a href="https://www.youtube.com/watch?v=SvBPfES3WfU" target="_blank" rel="noopener noreferrer">1986년 일본</a></dt><dd>조회수 74,000회. 오늘날 일본 신이 어떻게 만들어졌는가.</dd></div>
        </dl>
      </section>

      <section class="dash-section">
        <h2 class="dash-section__title">업계 관계</h2>
        <p>
          뮤지션, 밴드, 아티스트 매니지먼트, PR 및 레이블 프레스 담당자, 콘서트 사진가와의 협업 관계. 우리가 인터뷰하는 모든 밴드는 Music Cities 굿즈를 받아 갑니다.
        </p>
      </section>

      <section class="dash-section">
        <h2 class="dash-section__title">다루는 범위</h2>
        <p>
          헤비 뮤직이 벌어지는 곳이라면 어디든, 그리고 그것을 만들어내는 장소의 경제. 취재가 가장 깊은 곳은 플로리다와 마이애미, 그리고 일본과 아시아 전역이며, 이름 붙일 가치가 있는 모든 하위 장르, 신, 도시, 밴드로 확장됩니다. 페스티벌과 필드 트립은 최근
          <a href="/wacken">바켄</a>, <a href="/louder-than-life">Louder Than Life</a>, <a href="/london">Metal London</a> 등. 앨범 발매, 밴드 인터뷰, 그리고
          <a href="https://www.youtube.com/@musiccitiesradio" target="_blank" rel="noopener noreferrer">Music Cities Radio</a>.
        </p>
      </section>

      <section class="dash-section">
        <h2 class="dash-section__title">함께 일하기</h2>
        <dl class="press-defs">
          <div><dt>우리가 요청하는 것</dt><dd>공연장이 요구하는 경우의 공연 프레스 자격. 공연 당일 그린룸 또는 공연장에서의 밴드 인터뷰 시간. 밴드가 원할 경우 사운드체크 접근. 투어가 플로리다를 지날 때와 발매 시의 사전 연락.</dd></div>
          <div><dt>밴드가 받는 것</dt><dd>찾아오고, 후원하고, 티켓을 사는 관객에게 공개되는 인터뷰. 커리어 초기 밴드를 위한 3 Questions 쇼츠. Music Cities 굿즈. 공연 사진.</dd></div>
        </dl>
      </section>

      <section class="dash-section">
        <h2 class="dash-section__title">프레스 연락처</h2>
        <dl class="press-defs">
          <div><dt>담당</dt><dd>Kevin Crowder, 창업자</dd></div>
          <div><dt>소재지</dt><dd>미국 플로리다주 마이애미.</dd></div>
          <div><dt>이메일</dt><dd><a href="mailto:kevin@businessflare.net">kevin@businessflare.net</a></dd></div>
          <div><dt>소셜</dt><dd>
            <a href="https://www.youtube.com/@themusiccitiespodcast" target="_blank" rel="noopener noreferrer">YouTube</a>,
            <a href="https://www.instagram.com/themusiccities" target="_blank" rel="noopener noreferrer">Instagram</a>,
            <a href="https://x.com/themusiccities" target="_blank" rel="noopener noreferrer">X</a>,
            <a href="https://www.tiktok.com/@themusiccities" target="_blank" rel="noopener noreferrer">TikTok</a>,
            <a href="https://www.facebook.com/TheMusicCitiesPodcast" target="_blank" rel="noopener noreferrer">Facebook</a>
          </dd></div>
          <div><dt>뉴스레터</dt><dd><a href="https://www.linkedin.com/build-relation/newsletter-follow?entityUrn=7469968130384035841" target="_blank" rel="noopener noreferrer">Music Cities Setlists</a>, LinkedIn.</dd></div>
          <div><dt>다운로드</dt><dd>한 페이지 보도자료.
            <a href={PERMA + '/assets/the-music-cities-press-kit.pdf'} target="_blank" rel="noopener noreferrer">화면용 PDF</a> 또는
            <a href={PERMA + '/assets/the-music-cities-press-kit-print.pdf'} target="_blank" rel="noopener noreferrer">인쇄용 PDF</a>.
          </dd></div>
        </dl>
        <p class="press-foot">
          The Music Cities는 참전용사가 운영하는 경제 개발 회사
          <a href="https://businessflare.net" target="_blank" rel="noopener noreferrer">BusinessFlare</a>
          가 제작합니다. <a href="/">대시보드로 돌아가기</a>.
        </p>
      </section>

    </div>
  </main>

  <Footer />

  <style>
    .press-figs { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 1rem; margin: 1.5rem 0 2rem; }
    .press-figs figure { margin: 0; }
