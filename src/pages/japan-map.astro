<BaseLayout title="Japan Trip Map · Nov 4–16 2026 (private)" description="Private trip map." noindex={true}>
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" crossorigin="" />

  <main class="jm">
    <header class="jm-top">
      <div>
        <h1 class="jm-title">Japan Trip Map <span>日本旅行マップ</span></h1>
        <p class="jm-sub">November 4–16, 2026 · Kevin &amp; Lina · all travel inside Japan by train. Private planning map. <em>Updated {UPDATED}.</em></p>
      </div>
      <a class="jm-home" href="/">← musiccitiesconcerts.com</a>
    </header>

    <div class="jm-mapwrap">
      <div id="jmap"></div>
      <div class="jm-legend">
        <span><i class="dot" style="background:#2b6cff"></i>Hotel</span>
        <span><i class="dot" style="background:#e23b3b"></i>Venue</span>
        <span><i class="dot" style="background:#e0398a"></i>Tower Records</span>
        <span><i class="dot" style="background:#222"></i>Station / airport</span>
        <span><i class="dot" style="background:#2e9e5b"></i>Sight</span>
        <span><i class="dot" style="background:#9b59d0"></i>Point of interest</span>
        <span><i class="line" style="background:#e8821e"></i>Shinkansen / JR</span>
        <span><i class="line dash"></i>Local / taxi</span>
        <span class="jm-legend__note">Faded pin = tentative</span>
      </div>
    </div>

    {weatherOk && (
      <section class="jm-wx">
        <h2 class="jm-wx__h">Weather forecast <small>— for the days we&rsquo;re in each city</small></h2>
        <div class="jm-wx__grid">
          {weatherByCity.map((c) => (
            <div class="jm-wx__city">
              <h3 class="jm-wx__cityh">{c.en} <span class="jm-wx__ja">{c.ja}</span></h3>
              <div class="jm-wx__days">
                {c.days.map((d) => (
                  <div class="jm-wx__day">
                    <span class="jm-wx__dow">{d.wd} {d.dd}</span>
                    <span class="jm-wx__ico" title={d.label}>{d.emoji}</span>
                    <span class="jm-wx__temp"><strong>{d.hi}&deg;</strong> / {d.lo}&deg;</span>
                    <span class="jm-wx__pop">{d.pop}%</span>
                  </div>
                ))}
              </div>
            </div>
          ))}
        </div>
        <p class="jm-wx__note">High / low in &deg;C, and chance of rain. Forecast via Open-Meteo, updated {wxUpdated} &mdash; it firms up as the dates get closer.</p>
      </section>
    )}

    <section class="jm-stops">
      <h2 class="jm-stops__h">Stops <small>— tap one to fly there</small></h2>
      {stopsByCity.map((g) => (
        <div class="jm-citygroup">
          <h3 class="jm-citygroup__h">{g.city}</h3>
          <div class="jm-grid">
            {g.items.map((s) => (
              <div class={`jm-cardwrap jm-cat-${s.cat}${TENTATIVE.includes(s.status) ? ' is-tentative' : ''}`}>
                <button class="jm-card" data-id={s.id} type="button">
                  <div class="jm-card__top">
                    <span class="jm-card__name">{s.name} <span class="jm-card__ja">{s.ja}</span></span>
                    {TENTATIVE.includes(s.status) && <span class="jm-card__badge">{s.status}</span>}
                  </div>
                  {s.dates && <div class="jm-card__dates">{s.dates}</div>}
                  {s.note && <div class="jm-card__note">{s.note}</div>}
                </button>
                <div class="jm-card__links">
                  <a class="jm-card__link" href={gmap(s)} target="_blank" rel="noopener noreferrer">Map &amp; directions &#8599;</a>
                  {s.info && <a class="jm-card__link jm-card__link--info" href={s.info.url} target="_blank" rel="noopener noreferrer">{s.info.label} &#8599;</a>}
                </div>
              </div>
            ))}
          </div>
        </div>
      ))}
    </section>

    <section class="jm-travel">
      <h2 class="jm-stops__h">Travel</h2>
      <ul class="jm-travel__list">
        {travel.map((t) => (
          <li><b>{t.date}</b> · {t.text} <span class="jm-travel__mode">{t.mode}, {t.dur}</span></li>
        ))}
      </ul>
    </section>

    <section class="jm-links">
      <h2 class="jm-stops__h">Useful links</h2>
      <div class="jm-links__grid">
        <div class="jm-links__col">
          <h3 class="jm-links__h">Trains &amp; getting around</h3>
          <ul>
            <li><a href="https://world.jorudan.co.jp/mln/en/" target="_blank" rel="noopener noreferrer">Jorudan Japan Transit Planner</a><span>train routes &amp; times, English</span></li>
            <li><a href="https://japantravel.navitime.com/en/" target="_blank" rel="noopener noreferrer">NAVITIME for Japan Travel</a><span>routes, IC cards, English</span></li>
            <li><a href="https://smart-ex.jp/en/" target="_blank" rel="noopener noreferrer">Smart EX</a><span>reserve Nozomi shinkansen seats</span></li>
            <li><a href="https://www.google.com/maps" target="_blank" rel="noopener noreferrer">Google Maps</a><span>live directions &amp; transit</span></li>
          </ul>
        </div>
        <div class="jm-links__col">
          <h3 class="jm-links__h">Tickets &amp; essentials</h3>
          <ul>
            <li><a href="https://eplus.jp/" target="_blank" rel="noopener noreferrer">e+ (eplus)</a><span>show tickets &mdash; HAGANE deadline Nov 14, 6 PM</span></li>
            <li><a href="https://t.livepocket.jp/" target="_blank" rel="noopener noreferrer">LivePocket</a><span>show tickets (BBTS Nagoya, etc.)</span></li>
            <li><a href="https://tenki.jp/" target="_blank" rel="noopener noreferrer">tenki.jp</a><span>Japanese weather</span></li>
            <li><a href="https://www.jma.go.jp/bosai/en/" target="_blank" rel="noopener noreferrer">JMA forecast (English)</a><span>official weather service</span></li>
          </ul>
        </div>
      </div>
    </section>
  </main>

  <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" crossorigin=""></script>
  <script is:inline define:vars={{ pins, legs, cities }}>
    window.addEventListener('load', function () {
      if (typeof L === 'undefined') return;
      var colors = { hotel:'#2b6cff', venue:'#e23b3b', tower:'#e0398a', station:'#222', sight:'#2e9e5b', poi:'#9b59d0' };
      var tentative = ['maybe','planned','conditional','option'];

      var map = L.map('jmap', { scrollWheelZoom: true, zoomControl: true }).setView([35.0, 136.0], 6);
      L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
        maxZoom: 19, attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>'
      }).addTo(map);

      legs.forEach(function (leg) {
        var rail = leg.mode === 'rail';
        L.polyline([leg.from, leg.to], {
          color: rail ? '#e8821e' : '#8a8a8a', weight: rail ? 4 : 3,
          opacity: rail ? 0.9 : 0.8, dashArray: rail ? null : '6,8'
        }).addTo(map).bindTooltip(leg.label, { sticky: true });
      });

      var markers = {}; var bounds = [];
      pins.forEach(function (s) {
        var c = colors[s.cat] || '#444';
        var big = (s.cat === 'venue' || s.cat === 'hotel' || s.cat === 'tower');
        var size = big ? 15 : 11;
        var tent = tentative.indexOf(s.status) !== -1;
        var icon = L.divIcon({
          className: 'jm-pin',
          html: '<span style="display:block;width:' + size + 'px;height:' + size + 'px;border-radius:50%;background:' + c +
                ';border:2px solid #fff;box-shadow:0 1px 4px rgba(0,0,0,0.55);opacity:' + (tent ? 0.55 : 1) + '"></span>',
          iconSize: [size, size], iconAnchor: [size/2, size/2]
        });
        var statusHtml = tent ? '<span style="color:' + c + ';font-weight:700;text-transform:uppercase;font-size:.72em;letter-spacing:.04em"> · ' + s.status + '</span>' : '';
        var datesHtml = s.dates ? '<span style="display:block;margin-top:2px;font-size:.9em;opacity:.8">' + s.dates + '</span>' : '';
        var noteHtml = s.note ? '<span style="display:block;margin-top:4px">' + s.note + '</span>' : '';
        var gmapUrl = 'https://www.google.com/maps/search/?api=1&query=' + encodeURIComponent(((s.name||'') + ' ' + (s.ja||'')).trim());
        var linksHtml = '<span style="display:block;margin-top:7px"><a href="' + gmapUrl + '" target="_blank" rel="noopener" style="color:#4ea1ff;font-weight:700;text-decoration:none">Map &amp; directions \u2197</a>' + (s.info ? ' &nbsp;·&nbsp; <a href="' + s.info.url + '" target="_blank" rel="noopener" style="color:#4ea1ff;font-weight:700;text-decoration:none">' + s.info.label + ' \u2197</a>' : '') + '</span>';
        var popup = '<strong>' + s.name + '</strong> <span style="opacity:.55">' + s.ja + '</span>' + statusHtml + datesHtml + noteHtml + linksHtml;
        var tip = '<span class="jm-tip-name">' + s.name + '</span> <span class="jm-tip-ja">' + s.ja + '</span>' +
                  (s.note ? '<br><span class="jm-tip-info">' + s.note + '</span>' : '');
        var m = L.marker([s.lat, s.lon], { icon: icon }).addTo(map).bindPopup(popup)
          .bindTooltip(tip, { direction: 'top', offset: [0, -8], className: 'jm-tip' });
        markers[s.id] = m; bounds.push([s.lat, s.lon]);
      });

      map.fitBounds(bounds, { padding: [45, 45] });

      cities.forEach(function (c) {
        L.marker([c.lat, c.lon], { interactive: false, icon: L.divIcon({ className: 'jm-citylabel-wrap', html: '', iconSize: [0,0] }) })
          .addTo(map).bindTooltip('<span class="jm-city-en">' + c.en + '</span> <span class="jm-city-ja">' + c.ja + '</span>',
            { permanent: true, direction: 'auto', offset: [6, 0], className: 'jm-citylabel' });
      });

      document.querySelectorAll('.jm-card').forEach(function (card) {
        card.addEventListener('click', function () {
          var m = markers[card.getAttribute('data-id')];
          if (!m) return;
          map.flyTo(m.getLatLng(), 14, { duration: 0.8 });
          map.once('moveend', function () { m.openPopup(); });
          document.getElementById('jmap').scrollIntoView({ behavior: 'smooth', block: 'center' });
        });
      });
    });
  </script>

  <style>
