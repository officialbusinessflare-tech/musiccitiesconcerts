  .jm-wx__city { background: #141414; border: 1px solid #262626; border-radius: 12px; padding: 0.85rem 1rem; }
  .jm-wx__cityh { margin: 0 0 0.5rem; font-size: 1rem; }
  .jm-wx__ja { color: #8a8279; font-size: 0.8rem; font-weight: 400; }
  .jm-wx__days { display: flex; flex-direction: column; gap: 0.15rem; }
