  80:['🌦️','Light showers'], 81:['🌧️','Showers'], 82:['⛈️','Violent showers'],
  85:['🌨️','Snow showers'], 86:['❄️','Snow showers'],
  95:['⛈️','Thunderstorm'], 96:['⛈️','Thunderstorm'], 99:['⛈️','Thunderstorm'],
};
const wdOf = (d) => new Date(d + 'T00:00:00+09:00').toLocaleDateString('en-US', { weekday: 'short', timeZone: 'Asia/Tokyo' });
let weatherByCity = [];
let weatherOk = false;
try {
  for (const c of WX_CITIES) {
    const url = `https://api.open-meteo.com/v1/forecast?latitude=${c.lat}&longitude=${c.lon}&daily=weather_code,temperature_2m_max,temperature_2m_min,precipitation_probability_max&timezone=Asia%2FTokyo&start_date=${WX_START}&end_date=${WX_END}`;
    const r = await fetch(url);
    if (!r.ok) throw new Error('wx ' + r.status);
    const j = await r.json();
    const t = j.daily.time;
    const days = c.dates.map((d) => {
      const i = t.indexOf(d);
      if (i < 0) return null;
      const code = j.daily.weather_code[i];
      const [emoji, label] = WMO[code] || ['☁️', '—'];
      return {
        date: d, wd: wdOf(d), dd: d.slice(8), emoji, label,
        hi: Math.round(j.daily.temperature_2m_max[i]),
        lo: Math.round(j.daily.temperature_2m_min[i]),
        pop: j.daily.precipitation_probability_max[i],
      };
    }).filter(Boolean);
    weatherByCity.push({ en: c.en, ja: c.ja, days });
  }
  weatherOk = weatherByCity.length > 0;
} catch (e) {
  weatherOk = false;
  weatherByCity = [];
}
const wxUpdated = new Date().toISOString().slice(0, 10);
