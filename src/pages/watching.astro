  { name: 'We All Rise', interview: 'https://www.youtube.com/watch?v=MJnQVxduebk', favorite: true, scene: 'Florida Metal', match: 'we all rise', photos: 'https://www.pinterest.com/TheMusicCitiesPodcast/buried-alive-festival-las-rosas-miami/we-all-rise/',
