  { name: 'Follow Me, Fox!', scene: 'Florida Metal', match: 'follow me',
    why: "Orlando rock / pop-punk with video-game-themed hooks. High-energy live, newer project from experienced players." },

  // ---- Global / European metal ----
  { name: 'Nemesis', scene: 'Global Metal', match: 'nemesis', interview: 'https://www.youtube.com/watch?v=LUKyg4Dpddc',
    why: "Houston heavy metal built for the Wacken Metal Battle stage \u2014 old-school power with thrash bite and Texas grit.", socials: { instagram: 'https://www.instagram.com/nemesisriffs/' } },
  { name: 'Arch Enemy', scene: 'Global Metal', match: 'arch enemy',
    why: "Swedish melodic death metal royalty \u2014 Michael Amott's guitar leads over a ferocious vocal attack. Three decades in and still one of the biggest names in extreme metal.", socials: { x: 'https://x.com/archenemymetal', instagram: 'https://www.instagram.com/archenemyofficial/', youtube: 'https://www.youtube.com/@archenemyofficial', spotify: 'https://open.spotify.com/artist/0DCw6lHkzh9t7f8Hb4Z0Sx', site: 'https://archenemy.net/' } },
  { name: 'Given by the Flames', interview: 'https://www.youtube.com/watch?v=4GnvOdPDA3M', favorite: true, scene: 'Global Metal', match: 'given by the flames', photos: 'https://www.pinterest.com/TheMusicCitiesPodcast/given-by-the-flames-wacken/',
