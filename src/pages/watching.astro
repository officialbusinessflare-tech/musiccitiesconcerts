  { name: 'Ramtha', interview: 'https://www.youtube.com/watch?v=8t6jn_30VMY', favorite: true, scene: 'Florida Metal', match: 'ramtha',
    why: "Tampa thrash/death — friends of the channel, always on the Florida DIY bills worth driving for." },
  { name: 'Mind Virus', scene: 'Florida Metal', match: 'mind virus',
    why: "Florida underground metal, Big Ear Booking regulars. The Summer Weekender run put them on our radar." },

