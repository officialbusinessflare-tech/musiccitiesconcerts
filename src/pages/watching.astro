  { name: 'Maximum Friction', scene: 'Florida Metal', match: 'maximum friction',
    why: "West Palm Beach power trio, Sabbath-to-Slipknot heavy. Battle-of-the-bands winners climbing the local circuit." },
  { name: 'Nocturnal Dawn', interview: 'https://www.youtube.com/watch?v=ERucE5hitSY', scene: 'Florida Metal', match: 'nocturnal dawn',
