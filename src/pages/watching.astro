function socialLinks(s) {
  if (!s) return '';
  return SOCIAL_ORDER.filter(function (k) { return s[k]; }).map(function (k) {
    return '<a class="venues-card__social" href="' + s[k] + '" target="_blank" rel="noopener noreferrer" aria-label="' + SOCIAL_LABEL[k] + '" title="' + SOCIAL_LABEL[k] + '">' + SOCIAL_ICON[k] + '</a>';
  }).join('');
}

