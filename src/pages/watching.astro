---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import SceneNav from '../components/SceneNav.astro';
import Footer from '../components/Footer.astro';
import type { ConcertsDataFile, ConcertEntry } from '../lib/types';

import concertsData from '../../concerts.json';

/**
 * /watching — Bands We're Watching. The band equivalent of /venues.
 *
 * CURATION: edit the `watching` array below. Each band is a rich card grouped
 * by scene, with a one-line why and its next show pulled live from
 * concerts.json (matched on `match`). Add new bands here as we pick them up;
 * grouping falls out of the `scene` field automatically.
 */

type WatchBand = {
  name: string;
  scene: string;          // section grouping + pill label
  why: string;
  // Substring matched against the entry name in concerts.json (case-insensitive)
  match: string;
  interview?: string;   // YouTube URL of the band's TMC interview
  favorite?: boolean;   // shows the "one of our favorites" badge
  photos?: string;   // Pinterest board URL
  socials?: {        // full URLs; only present platforms render
    x?: string;
    instagram?: string;
    youtube?: string;
    spotify?: string;
    facebook?: string;
    tiktok?: string;
    site?: string;   // official site or Bandcamp
  };
};

const watching: WatchBand[] = [
  // ---- Coming to the channel (featured) ----
  { name: 'Nini — Nini Music', favorite: true, scene: 'Coming to the channel', match: 'nini music',
    why: "We recorded a full interview with Nini, now live on the channel.",
    interview: 'https://www.youtube.com/watch?v=r8klGaDF1gE',
    socials: { instagram: 'https://www.instagram.com/ninimusicofficial/', youtube: 'https://www.youtube.com/channel/UCUUIp1k0tywKM1oGMkkuFvw', spotify: 'https://open.spotify.com/artist/4iggZUAEXfBeJH9DjKwccm', site: 'https://ninimusic.me/' } },

  // ---- Japanese / Asian metal ----
  { name: 'BRIDEAR', interview: 'https://www.youtube.com/watch?v=QGW5tLmv_Ds', favorite: true, scene: 'Japanese Metal', match: 'bridear',
    why: "All-women heavy and power metal out of Fukuoka \u2014 twin-guitar melodic firepower under Kimi's soaring vocals, and a relentless live act built for the international stage.", socials: { x: 'https://x.com/Bridear_info', instagram: 'https://www.instagram.com/bridear_jp/', youtube: 'https://www.youtube.com/channel/UCqkHezzlbqWrmOhoTcZTVjg', spotify: 'https://open.spotify.com/artist/3h6F7NaadGF3Ayf3FJBjdR', site: 'https://bridear.jp/en' } },
  { name: 'LOVEBITES', scene: 'Japanese Metal', match: 'lovebites', photos: 'https://www.pinterest.com/TheMusicCitiesPodcast/lovebites-wacken/',
    why: "Japanese power metal at the top of the form. Twin-guitar precision, operatic range — the band the whole watch list orbits." },
  { name: 'NEMOPHILA', interview: 'https://www.youtube.com/watch?v=pJmFKOQ38e0', favorite: true, scene: 'Japanese Metal', match: 'nemophila',
    why: "All-women Japanese metal built for the live room — Mayu's roar over relentless riffing. Ten Fes is theirs." },
  { name: 'HANABIE.', favorite: true, scene: 'Japanese Metal', match: 'hanabie', photos: 'https://www.pinterest.com/TheMusicCitiesPodcast/hanabie-orlando-2026/',
    why: "Harajuku-core: candy-colored, breakdown-heavy, touring the US non-stop. The gateway drug for the whole scene." },
  { name: 'BAND-MAID', scene: 'Japanese Metal', match: 'band-maid',
    why: "Maid-café aesthetic, hard-rock chops that silence the doubters the second Kanami solos." },
  { name: 'BABYMETAL', scene: 'Japanese Metal', match: 'babymetal',
    why: "The ones who kicked the door in. Kawaii metal as a global stadium act; still the reference point." },
  { name: 'Rolling Quartz', scene: 'Japanese Metal', match: 'rolling quartz',
    why: "Korean hard-rock five-piece crisscrossing North America on the MY TURN tour. Loud, tight, relentless." },
  { name: 'Broken By The Scream', interview: 'https://www.youtube.com/watch?v=Sky1HWb5cP8', favorite: true, scene: 'Japanese Metal', match: 'broken by the scream', photos: 'https://www.pinterest.com/TheMusicCitiesPodcast/broken-by-the-scream-wacken-2026/',
    why: "Metal-screaming idol act, Metal Blade signees, Wacken alumni. Caught live at The Dome with a meet and greet." },
  { name: 'Fathomless Skywalker', scene: 'Japanese Metal', match: 'fathomless skywalker',
    why: "Tokyo symphonic metalcore led by classically-trained Chihiro. 'Pirates of the Fathomless Sea' hit #4 on Japan iTunes Metal." },
  { name: 'SiM', scene: 'Japanese Metal', match: 'sim',
    why: "Japanese reggae-metalcore heavyweights on the HOOMAN AFTER ALL world tour. The heaviest groove on the list." },
  { name: 'FATE GEAR', scene: 'Japanese Metal', match: 'fate gear',
    why: "All-women steampunk / gothic power metal. The Frozen Abyss tour took them to Europe for the first time." },

  { name: 'ZILQY', scene: 'Japanese Metal', match: 'zilqy',
    why: "Heavy-metal supergroup — ex-Aldious guitarist Toki's new vehicle. The 'Birth of Riot' tour is one of the fall's hottest tickets." },
  { name: 'Lonesome_Blue', scene: 'Japanese Metal', match: 'lonesome',
    why: "Melodic-metal supergroup fronted by Sally (ex-BRIDEAR). 'FOURTH DIMENSION' out this year; built for the big stage." },
  { name: 'SAKI', scene: 'Japanese Metal', match: 'saki (',
    why: "Guitar virtuoso (NEMOPHILA, ex-Mary's Blood) stepping out solo — a major debut album and her own project." },
  { name: 'Dimrays', scene: 'Japanese Metal', match: 'dimrays',
    why: "Osaka metalcore duo — Akane on vocals, Naho on bass. Clean-to-scream dynamics, rising fast." },

  // ---- Florida metal scene ----
  { name: 'McFisty', interview: 'https://www.youtube.com/watch?v=Ltyj3hbklU8', scene: 'Florida Metal', match: 'mcfisty',
    why: "Our own. Yes, The Music Cities is in a band. South Florida heavy bluesy metal. Raw, loud, and no gimmicks.", socials: { instagram: 'https://www.instagram.com/mcfistymetal/', youtube: 'https://www.youtube.com/@mcfistymetal', facebook: 'https://www.facebook.com/McFistyRocks', tiktok: 'https://www.tiktok.com/@mcfisty8', spotify: 'https://open.spotify.com/artist/4PnZJh0LfwPqfgh6WLJ7kF', site: 'https://mcfisty.com/' } },
  { name: 'Out of the Ashes', interview: 'https://www.youtube.com/watch?v=kDJjh_X1DQc', scene: 'Florida Metal', match: 'out of the ashes',
