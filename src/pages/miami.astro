---
/**
 * Miami Metal — Miami-Dade-specific view of the Florida scene.
 *
 * Same data pipeline as /florida, then narrowed to Miami-Dade shows by
 * venue + city keyword. Miami is the proof-of-concept scene: build it here,
 * build it anywhere.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import SceneNav from '../components/SceneNav.astro';
import Footer from '../components/Footer.astro';
import ShowCard from '../components/ShowCard.astro';
import ReleaseCard from '../components/ReleaseCard.astro';
import VideoStrip from '../components/VideoStrip.astro';
import type { BucketsConfigFile, ConcertsDataFile, ConcertEntry, BirthdaysDataFile } from '../lib/types';
import { categorize, groupByBucket } from '../lib/categorize';
import { collectKnownVenues, reparseEntry } from '../lib/parse-name';

import bucketsConfig from '../../buckets.config.json';
import concertsData from '../../concerts.json';
import birthdaysData from '../../birthdays.json';

let ytData: any = {
  channels: { tmc: { recentLongform: [], recentShorts: [] }, radio: { recentLongform: [], recentShorts: [] } },
  playlists: {},
};
try {
  ytData = (await import('../../public/youtube-content.json')).default ?? ytData;
} catch (err) {}
const radioShorts = ytData?.channels?.radio?.recentShorts ?? [];

const buckets = (bucketsConfig as BucketsConfigFile).buckets;
const data = concertsData as ConcertsDataFile;
const knownVenues = collectKnownVenues(buckets);
const birthdays = (birthdaysData as BirthdaysDataFile).entries ?? [];

const today = new Date().toISOString().slice(0, 10);
const upcoming: ConcertEntry[] = (data.entries ?? [])
  .filter((e) => {
    const compareDate = e.endDate ?? e.date;
    return compareDate >= today;
  })
  .map((e) => reparseEntry(e, knownVenues))
  .map((e) => ({ ...e, buckets: categorize(e, buckets) }));

const grouped = groupByBucket(upcoming, buckets);

// --- Miami-Dade filter: iconic Miami metal rooms + Miami-Dade cities ---
const MIAMI_VENUES = ['churchill', 'las rosas', 'gramps', 'bar nancy', 'guadalajara', 'banyan live', 'boombox', 'the ground', 'hoy como ayer', 'kill your idol', 'on the rocks'];
const MIAMI_CITIES = ['miami', 'hialeah', 'coral gables', 'doral', 'homestead', 'cutler bay', 'kendall', 'wynwood', 'little haiti', 'little havana', 'miami beach', 'miami gardens', 'aventura', 'north miami'];

function isMiami(e: ConcertEntry): boolean {
  const v = (e.venue || '').toLowerCase();
  const city = (e.city || '').toLowerCase();
  if (MIAMI_VENUES.some((k) => v.includes(k))) return true;
  if (MIAMI_CITIES.some((k) => city.includes(k))) return true;
  return false;
}

const entries = upcoming
  .filter((e) => (e.buckets ?? []).includes('florida-metal-scene'))
  .filter(isMiami)
  .sort((a, b) => a.date.localeCompare(b.date));
---

<BaseLayout
  title="Miami Metal | The Music Cities"
  description="Miami's metal scene calendar — every show we're tracking across Churchill's, Las Rosas, Gramps, and the rest of the 305."
>
  <Header />
  <SceneNav buckets={buckets} grouped={grouped} birthdaysCount={birthdays.length} activeBucketId="miami" />

  <section class="bucket-hero">
    <div class="container">
      <p class="bucket-hero__eyebrow">On the calendar</p>
      <h1 class="bucket-hero__title">
        Miami Metal
        <span class="bucket-hero__count">{entries.length}</span>
      </h1>
      <p class="bucket-hero__lede">
        Every metal show we're tracking across the 305 — Churchill's, Las Rosas, Gramps, and the rooms
        building the scene. Miami is the proof of concept: build it here, build it anywhere.
      </p>
    </div>
  </section>

  <main class="bucket-page">
    <div class="container">
      {entries.length === 0 ? (
        <p class="bucket__empty">Nothing on the Miami calendar right now. The next flyer is coming — check back.</p>
      ) : (
        <div class="bucket__grid">
          {entries.map((entry) =>
            entry.isRelease ? <ReleaseCard entry={entry} /> : <ShowCard entry={entry} />,
          )}
        </div>
      )}
    </div>
  </main>

  <VideoStrip title="Performance Shorts" videos={radioShorts.slice(0, 6)} channelBadge="Radio" layout="scroll" />

  <Footer />
</BaseLayout>
