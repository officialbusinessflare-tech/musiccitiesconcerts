    .rev-body a { color: #e6e2da; }
    .rev-body a:hover { color: #fff; }
    .rev-standfirst { color: #8a8279 !important; font-size: 0.95rem !important; border-bottom: 1px solid #212121; padding-bottom: 1rem; }
    .rev-h2 { margin: 2.25rem 0 0.85rem; font-size: 1.35rem; line-height: 1.2; }
    .rev-verdict { display: flex; align-items: center; gap: 1.25rem; background: linear-gradient(135deg, #1a1712, #121212); border: 1px solid #3a2f1c; border-left: 4px solid #c9a24b; border-radius: 12px; padding: 1.25rem 1.5rem; margin: 1.75rem 0; }
    .rev-verdict__badge { width: 96px; height: 96px; flex: 0 0 auto; }
    .rev-verdict__label { font-family: inherit; font-weight: 800; letter-spacing: 0.04em; text-transform: uppercase; color: #e8c877; font-size: 1.05rem; margin: 0 0 0.4rem; }
    .rev-verdict__text { color: #e3ddd2 !important; line-height: 1.65; margin: 0; font-size: 1.02rem; }
    .rev-verdict__text strong { color: #f3eddf; }
    @media (max-width: 620px) { .rev-verdict { flex-direction: column; text-align: center; gap: 0.75rem; } }
    .rev-attrib { color: #9a948a !important; font-style: italic; font-size: 0.95rem !important; }
    .rev-sources { color: #8a8279 !important; font-size: 0.88rem !important; border-top: 1px solid #212121; padding-top: 1rem; margin-top: 2rem; }

