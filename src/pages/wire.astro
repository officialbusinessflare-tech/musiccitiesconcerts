---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import SceneNav from '../components/SceneNav.astro';
import Footer from '../components/Footer.astro';

/**
 * /wire — The Label Wire.
 *
 * Two sections, both organized by record label:
 *   - "From the label desks": announcements the labels and their PR crews send us
 *     (Napalm Records, Back on Black via Palmer Turner Overdrive, and more).
 *   - "On our watch list": the upcoming records we already track on Album Releases,
 *     mirrored here under their label.
 *
 * This is audience-facing: subscribers first. No interview logistics, no PR-desk
 * plumbing. Each item shows the actual record label the release is on.
 *
 * Data: label-wire.json at repo root. entry.kind is "send" or "pick".
 */
import wireData from '../../label-wire.json';

type WireLabel = { id: string; name: string; url?: string };
type WireEntry = { kind: string; date: string; label: string; artist: string; headline: string; type: string; releaseDate?: string; pr?: string };

const labels = (wireData.labels ?? []) as WireLabel[];
const labelById = new Map(labels.map((l) => [l.id, l]));
const all = (wireData.entries ?? []) as WireEntry[];

// Andy Turner's PR desk (pr: "pto") always sorts first when items share a day.
const andyFirst = (a: WireEntry, b: WireEntry) => (a.pr === 'pto' ? 0 : 1) - (b.pr === 'pto' ? 0 : 1);

const sends = all
  .filter((e) => e.kind !== 'pick')
  .sort((a, b) => (a.date !== b.date ? (a.date < b.date ? 1 : -1) : andyFirst(a, b)));

const picks = all
  .filter((e) => e.kind === 'pick')
  .sort((a, b) => {
    const ad = a.releaseDate ?? a.date;
    const bd = b.releaseDate ?? b.date;
    if (ad !== bd) return ad < bd ? -1 : 1;
    return andyFirst(a, b);
  });

function fmt(d: string) {
  const parts = d.split('-').map((n) => parseInt(n, 10));
  const dt = new Date(parts[0], parts[1] - 1, parts[2]);
  return dt.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
}

const lastUpdated = wireData.generatedAt
  ? new Date(wireData.generatedAt).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })
  : null;
---

<BaseLayout
  title="The Label Wire | The Music Cities"
  description="Label and PR announcements plus every upcoming record we track, organized by label. Napalm Records, Back on Black, Bushiroad, Pony Canyon and more."
>
  <Header />
  <SceneNav />

  <section class="dash-hero">
    <div class="container">
      <p class="dash-hero__eyebrow">Bulletin</p>
      <h1 class="dash-hero__title">The Label <em>Wire</em></h1>
      <p class="dash-hero__subtitle">Straight from the desks that keep the scene moving.</p>
      <p class="dash-hero__lede">
        What the labels and their crews send us, plus every upcoming record we're already tracking,
        organized by label. Big thanks to the crews who keep us on the list.
        {lastUpdated ? <span>Last updated {lastUpdated}.</span> : null}
      </p>
      <div class="wire-credits">
        <span class="wire-credits__label">On the wire:</span>
        {labels.map((l) => (
          l.url
            ? <a class="wire-credits__pill" href={l.url} target="_blank" rel="noopener noreferrer">{l.name}</a>
            : <span class="wire-credits__pill">{l.name}</span>
        ))}
      </div>
    </div>
  </section>

  <main class="dash-main">
    <div class="container">

      <section class="dash-section">
        <h2 class="dash-section__title">From the label desks</h2>
        <ol class="wire-list">
          {sends.map((e) => {
            const lab = labelById.get(e.label);
            return (
              <li class="wire-item wire-item--send">
                <div class="wire-item__meta">
                  <span class="wire-item__date">{fmt(e.date)}</span>
                  <span class="wire-item__source">{lab ? lab.name : e.label}</span>
                  {e.type ? <span class="wire-item__type">{e.type}</span> : null}
                </div>
                <p class="wire-item__body">
                  <span class="wire-item__artist">{e.artist}</span>
                  {' — '}{e.headline}
                </p>
              </li>
            );
          })}
        </ol>
      </section>

      <section class="dash-section">
        <h2 class="dash-section__title">On our watch list</h2>
        <p class="wire-note">The upcoming records we track on Album Releases, mirrored here under their label.</p>
        <ol class="wire-list">
          {picks.map((e) => {
            const lab = labelById.get(e.label);
            return (
              <li class="wire-item wire-item--pick">
                <div class="wire-item__meta">
                  <span class="wire-item__date">{fmt(e.releaseDate ?? e.date)}</span>
                  <span class="wire-item__source">{lab ? lab.name : e.label}</span>
                  {e.type ? <span class="wire-item__type">{e.type}</span> : null}
                </div>
                <p class="wire-item__body">
                  <span class="wire-item__artist">{e.artist}</span>
                  {' — '}{e.headline}
                </p>
              </li>
            );
          })}
        </ol>
      </section>

      <p class="wire-foot">
        The watch-list section mirrors our <a href="/releases">Album Releases</a> page. Want on the wire?
        Put The Music Cities on your list and it shows up here.
      </p>

    </div>
  </main>

  <Footer />
</BaseLayout>

<style>
  .wire-credits { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; margin-top: 18px; }
  .wire-credits__label { font-size: 12px; text-transform: uppercase; letter-spacing: .08em; color: #8a8279; }
  .wire-credits__pill { display: inline-block; padding: 5px 12px; border-radius: 999px; background: #1b1b1b; border: 1px solid #333; color: #e6e2da; font-size: 13px; font-weight: 600; text-decoration: none; }
  a.wire-credits__pill:hover { border-color: #e50914; color: #fff; }

  .wire-note { color: #8a8279; font-size: 13.5px; margin: 0 0 4px; }

  .wire-list { list-style: none; margin: 16px 0 0; padding: 0; border-top: 1px solid #262626; }
  .wire-item { padding: 16px 0 16px 16px; border-bottom: 1px solid #262626; border-left: 3px solid #333; }
  .wire-item--pick { border-left-color: #e50914; }
  .wire-item__meta { display: flex; flex-wrap: wrap; align-items: center; gap: 10px; margin-bottom: 5px; }
  .wire-item__date { font-size: 12.5px; color: #8a8279; font-variant-numeric: tabular-nums; }
  .wire-item__source { font-size: 11px; text-transform: uppercase; letter-spacing: .06em; color: #b7b2a9; }
  .wire-item__type { font-size: 10.5px; text-transform: uppercase; letter-spacing: .06em; color: #6f6a62; border: 1px solid #333; border-radius: 4px; padding: 1px 6px; }
  .wire-item__body { margin: 0; font-size: 15.5px; line-height: 1.5; color: #d9d4ca; }
  .wire-item__artist { font-weight: 700; color: #fff; }

  .wire-foot { margin: 28px 0 0; color: #8a8279; font-size: 14px; line-height: 1.6; }
  .wire-foot a { color: #e6e2da; }
  .wire-foot a:hover { color: #fff; }
</style>
