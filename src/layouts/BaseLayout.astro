---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
}

const {
  title = 'The Music Cities Concerts Dashboard',
  description = 'Curated metal concerts, festivals, and album releases. Where heavy metal is economic development.',
  ogImage = '/assets/og-hero.png',
} = Astro.props;

const siteUrl = Astro.site?.toString().replace(/\/$/, '') ?? '';
const canonical = new URL(Astro.url.pathname, Astro.site ?? 'https://music-cities-concerts.netlify.app').toString();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#0a0a0a" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="Music Cities" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={siteUrl + ogImage} />
    <meta property="og:site_name" content="The Music Cities" />

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={siteUrl + ogImage} />
  </head>
  <body>
    <slot />
    <!-- Cloudflare Web Analytics --><script defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon={`{"token": "19a17510ec284235afcd37bb0a0e4f20"}`}></script><!-- End Cloudflare Web Analytics -->
    <script is:inline>
      if ("serviceWorker" in navigator) {
        window.addEventListener("load", function () {
          navigator.serviceWorker.register("/sw.js").catch(function () {});
        });
      }
    </script>
    <!-- Install app affordance (Android/desktop native prompt; iOS shows instructions) -->
    <button id="pwa-install" class="pwa-install" type="button" hidden aria-label="Install the Music Cities app">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3v10.6l3.3-3.3 1.4 1.4L12 17.4 7.3 12.7l1.4-1.4L12 13.6V3zM5 19h14v2H5z"/></svg>
      Install app
    </button>
    <div id="pwa-ios-sheet" class="pwa-ios-sheet" hidden>
      <div class="pwa-ios-sheet__card" role="dialog" aria-modal="true" aria-label="Install instructions">
        <p class="pwa-ios-sheet__title">Add The Music Cities to your Home Screen</p>
        <p class="pwa-ios-sheet__body">In Safari, tap the <strong>Share</strong> icon, then choose <strong>Add to Home Screen</strong>.</p>
        <button id="pwa-ios-close" class="pwa-ios-sheet__btn" type="button">Got it</button>
      </div>
    </div>
    <style is:global>
      .pwa-install{position:fixed;right:16px;bottom:16px;z-index:9999;display:inline-flex;align-items:center;gap:.5rem;background:#e11d2a;color:#fff;border:none;border-radius:999px;padding:.7rem 1.05rem;font:600 .9rem/1 -apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,sans-serif;box-shadow:0 6px 18px rgba(0,0,0,.4);cursor:pointer}
      .pwa-install svg{width:18px;height:18px;fill:currentColor;display:block}
      .pwa-install:hover{background:#c81020}
      .pwa-ios-sheet{position:fixed;inset:0;z-index:10000;background:rgba(0,0,0,.62);display:flex;align-items:flex-end;justify-content:center}
      .pwa-ios-sheet__card{background:#141414;color:#f4f1ea;border:1px solid #2a2a2a;border-bottom:none;border-radius:16px 16px 0 0;padding:22px 20px calc(22px + env(safe-area-inset-bottom));max-width:560px;width:100%;text-align:center}
      .pwa-ios-sheet__title{margin:0 0 8px;font-size:1.05rem;font-weight:700}
      .pwa-ios-sheet__body{margin:0 0 16px;font-size:.92rem;color:#c9c2b8;line-height:1.5}
      .pwa-ios-sheet__btn{background:#e11d2a;color:#fff;border:none;border-radius:8px;padding:.6rem 1.4rem;font-size:.9rem;font-weight:600;cursor:pointer}
      @media (display-mode: standalone){.pwa-install,.pwa-ios-sheet{display:none !important}}
    </style>
    <script is:inline>
      (function(){
        var btn=document.getElementById("pwa-install");
        var sheet=document.getElementById("pwa-ios-sheet");
        var closeBtn=document.getElementById("pwa-ios-close");
        if(!btn) return;
        var standalone=window.matchMedia("(display-mode: standalone)").matches||window.navigator.standalone===true;
        if(standalone) return;
        var isIOS=/iphone|ipad|ipod/i.test(navigator.userAgent);
        var deferred=null;
        window.addEventListener("beforeinstallprompt",function(e){e.preventDefault();deferred=e;btn.hidden=false;});
        window.addEventListener("appinstalled",function(){btn.hidden=true;deferred=null;if(sheet)sheet.hidden=true;});
        if(isIOS){btn.hidden=false;}
        btn.addEventListener("click",function(){
          if(deferred){deferred.prompt();deferred.userChoice.then(function(){deferred=null;btn.hidden=true;});}
          else if(sheet){sheet.hidden=false;}
        });
        if(closeBtn)closeBtn.addEventListener("click",function(){sheet.hidden=true;});
        if(sheet)sheet.addEventListener("click",function(e){if(e.target===sheet)sheet.hidden=true;});
      })();
    </script>
  </body>
</html>
